# Copy to .deploy.env (gitignored) and fill in. Used by scripts/deploy-remote.sh.
#
#   cp .deploy.env.example .deploy.env
#
# Prefer SSH key auth. Generate and install a key once:
#   ssh-keygen -t ed25519 -C "deploy@antigravity"
#   ssh-copy-id -i ~/.ssh/id_ed25519.pub root@129.121.97.152
#
# After that, VPS_PASSWORD is not needed at all.

VPS_HOST=129.121.97.152
VPS_USER=root
VPS_APP_DIR=/root/resume-screening-app
GIT_BRANCH=main

# Recommended: path to your private key.
VPS_SSH_KEY=$HOME/.ssh/id_ed25519

# Fallback only — requires sshpass, and puts a credential on disk.
# Leave blank if you are using key auth.
VPS_PASSWORD=
