DEEPSEEK_API_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000/api
DATABASE_URL=
REDIS_URL=

# ─── Public application URL (REQUIRED) ─────────────────────────────────────────
# Base URL of the candidate-facing FRONT-END. Assessment and candidate-portal
# links in outgoing emails are built from this value, so it must point at the
# Next.js host — NOT the API host — or every candidate link will 404.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Recruitment pipeline ──────────────────────────────────────────────────────
# Only applications received at/after this date are ingested and screened.
# Pin this to your go-live date. Leave blank to use "start of today".
INGESTION_CUTOFF_DATE=

# Only applicants whose application arrived at/after this date receive the
# "Application Received" acknowledgement email. Deliberately separate from
# INGESTION_CUTOFF_DATE above (which is usually already in the past by the time
# this is turned on) so existing/previous applicants are never acknowledged.
# Pin this to the date this change goes live. Leave blank to use "start of today".
ACKNOWLEDGEMENT_CUTOFF_DATE=

# Global kill switch: when true, no candidate-facing or HR-facing email is ever
# actually delivered, regardless of Zoho/SMTP config or a tenant's saved email
# provider settings. Every send is logged as if delivered (for idempotency testing)
# but nothing is sent. Use for dry-run testing only — never set true in production.
DRY_RUN_EMAILS=false

# Internal HR recipient for stage notifications (leave blank to disable).
HR_NOTIFICATION_EMAIL=
ENABLE_HR_EMAIL_NOTIFICATIONS=false

# Stage thresholds (percentages).
PIPELINE_SHORTLIST_THRESHOLD=80
PIPELINE_REVIEW_THRESHOLD=60
PIPELINE_JOB_MATCH_FLOOR=50
PIPELINE_INTERVIEW_THRESHOLD=80

# Attach applicants only to the opening they actually applied for. When the target
# job can't be determined they go to HR Review unmapped, instead of being
# auto-assigned to the best-matching role.
STRICT_JOB_MAPPING=true

# Keka supplies job openings and resumes only; it must not write candidate status.
KEKA_OWNS_CANDIDATE_STATUS=false
# Route inbound Zoho mailbox applications to this tenant when several exist.
ZOHO_SYNC_TENANT_ID=

# Assessment validity window, and the day(s) after the invite to send a reminder.
ASSESSMENT_VALIDITY_DAYS=7
ASSESSMENT_REMINDER_DAYS=3,4

# Legacy text-extraction worker. Must stay false: it consumes the same queue as
# the real screening worker and would swallow resumes.
ENABLE_LEGACY_PARSE_WORKER=false

# Per-candidate email rate ceilings (safety nets; per-stage dedup is automatic).
MAX_EMAILS_PER_RECIPIENT_PER_DAY=6
MAX_EMAILS_PER_RECIPIENT_LIFETIME=25

# ─── AI parsing safety ─────────────────────────────────────────────────────────
# MUST stay false in production. When true, a regex "mock" parser fabricates
# candidate data (fake name, email and scores) if every AI provider fails.
ALLOW_MOCK_PARSER=false
# Attempts per AI provider before failing over to the next one.
AI_PARSE_ATTEMPTS=2

# ─── Data retention ────────────────────────────────────────────────────────────
# Candidate records are retained indefinitely. These only govern pruning of
# storage files that no database row references.
STORAGE_PRUNE_MIN_AGE_HOURS=48
STORAGE_PRUNE_MAX_RATIO=0.5
# Required (with CONFIRM_DESTRUCTIVE_ACTION=YES) to run any destructive script.
CONFIRM_DESTRUCTIVE_ACTION=

# Zoho Mail Integration Configuration
ZOHO_MAIL_ENABLED=false
ZOHO_MAIL_USER_EMAIL=hr@company.com
ZOHO_MAIL_CLIENT_ID=
ZOHO_MAIL_CLIENT_SECRET=
ZOHO_MAIL_REFRESH_TOKEN=
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USER=hr@company.com
ZOHO_SMTP_PASSWORD=your_zoho_app_password_here
ZOHO_SMTP_SENDER_NAME=Your Company HR
ZOHO_MAIL_INBOX_POLL_INTERVAL=60000

# AI Provider Configuration ("deepseek" | "openai" | "gemini")
AI_PROVIDER=deepseek
OPENAI_API_KEY=
GEMINI_API_KEY=

# Keka API Integration Configuration
KEKA_ENABLED=false
KEKA_BASE_URL=
KEKA_API_KEY=
KEKA_CLIENT_ID=
KEKA_CLIENT_SECRET=
KEKA_WEBHOOK_SECRET=

